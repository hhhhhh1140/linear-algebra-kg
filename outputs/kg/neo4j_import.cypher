// 用法：cypher-shell -f neo4j_import.cypher，或粘贴到 Neo4j Browser 运行
CREATE CONSTRAINT la_con_name IF NOT EXISTS FOR (n:`概念`) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT la_thm_name IF NOT EXISTS FOR (n:`定理`) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT la_prop_name IF NOT EXISTS FOR (n:`性质`) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT la_op_name IF NOT EXISTS FOR (n:`运算`) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT la_meth_name IF NOT EXISTS FOR (n:`方法`) REQUIRE n.name IS UNIQUE;
