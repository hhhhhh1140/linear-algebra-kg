MATCH (a:`概念` {name:'零向量'}), (b:`概念` {name:'向量'}) MERGE (a)-[r:`上位概念`]->(b) SET r.relation='is_a', r.source='seed';
MATCH (a:`概念` {name:'行向量'}), (b:`概念` {name:'向量'}) MERGE (a)-[r:`上位概念`]->(b) SET r.relation='is_a', r.source='seed';
